```gitignore
# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Build output
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/

# Test results
TestResults/
*.trx
*.testlog
*.coverage
*.coveragexml

# NuGet
packages/
*.nupkg
*.snupkg

# .NET
project.lock.json
project.fragment.lock.json
artifacts/

# Rider / JetBrains
.idea/
*.sln.iml

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# VS Code
.vscode/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log

# Temporary files
*.tmp
*.temp
*.cache

# OneDrive
*.tmp
```
